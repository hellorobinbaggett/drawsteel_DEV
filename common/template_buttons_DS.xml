<root>
	<!-- Draw Steel buttons -->
	<template name="power_roll">
		<buttoncontrol>
			<anchored width="20" height="20" />
			<icon normal="button_roll" pressed="button_roll_down" />
		</buttoncontrol>
	</template>

	<template name="NEW_power_roll">
		<buttoncontrol>
			<anchored width="200" height="200" />
			<icon normal="button_roll" pressed="button_roll_down" />
		</buttoncontrol>
	</template>

	<template name="power_roll_skill">
		<buttoncontrol>
			<anchored width="32" height="32" />
			<icon normal="button_roll" pressed="button_roll_down" />
		</buttoncontrol>
	</template>

	<template name="NEW_power_roll_skill">
		<buttoncontrol>
			<anchored width="200" height="200" />
			<icon normal="button_roll" pressed="button_roll_down" />
		</buttoncontrol>
	</template>

	<template name="initiative_roll">
		<buttoncontrol>
			<anchored width="32" height="32" />
			<icon normal="button_roll" hover="button_roll" pressed="button_roll_down" />
		</buttoncontrol>
	</template>

	<template name="classresource_roll">
		<buttoncontrol>
			<anchored width="32" height="32" />
			<icon normal="button_add" pressed="button_add_down" />
		</buttoncontrol>
	</template>

	<template name="respite_button">
		<buttoncontrol>
			<anchored width="40" height="40" />
			<icon normal="respite" pressed="respite_down" />
			<tooltip textres="char_tooltip_respite" />
		</buttoncontrol>
	</template>

	<template name="ability_button">
		<buttoncontrol>
			<anchored width="32" height="32" />
			<icon normal="button_roll" pressed="button_roll_down" />
		</buttoncontrol>
	</template>

	<template name="signature_button">
		<buttoncontrol>
			<anchored width="32" height="32" />
			<icon normal="button_action_attack" pressed="button_action_attack_down" />
		</buttoncontrol>
	</template>

	<template name="maneuver_button">
		<buttoncontrol>
			<anchored width="32" height="32" />
			<icon normal="button_action_heal" pressed="button_action_heal_down" />
		</buttoncontrol>
	</template>

	<template name="heroic_button">
		<buttoncontrol>
			<anchored width="32" height="32" />
			<icon normal="button_action_damage" pressed="button_action_damage_down" />
		</buttoncontrol>
	</template>
</root>
